# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite o .env.local — ele está no .gitignore.

# URL da Web App publicada no Google Apps Script
# Você vai obter essa URL na Fase 3 do projeto (Apps Script)
# Formato: https://script.google.com/macros/s/SEU_ID_AQUI/exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/COLE_SUA_URL_AQUI/exec

# Senha secreta para validar que a requisição veio do scraper
# Use qualquer string aleatória longa — ex: gerada em https://passwordsgenerator.net
APPS_SCRIPT_SECRET=coloque_uma_senha_longa_e_aleatoria_aqui
